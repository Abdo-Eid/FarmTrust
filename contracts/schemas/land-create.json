{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farmtrust.local/contracts/land-create.json",
  "title": "CreateLandPayload",
  "type": "object",
  "required": ["name", "governorate", "method", "geometry", "area_feddan"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "governorate": { "type": "string", "minLength": 1 },
    "district": { "type": "string" },
    "notes": { "type": "string" },
    "method": { "const": "polygon" },
    "area_feddan": { "type": "number", "exclusiveMinimum": 0 },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": true,
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
