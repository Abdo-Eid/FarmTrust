# Python-generated files
__pycache__/
**/__pycache__/
*.py[oc]
*.pyc
build/
dist/
wheels/
*.egg-info

# Runtime / cache
.cache/

# Jupyter noise
**/.ipynb_checkpoints/
worker/notebooks/.cache/

# Research/model artifacts
data/research/
data/*.csv
data/*.xlsx
data/*.xls
*.joblib
*.pkl
*.pickle

# Virtual environments
.venv
.venv/

# OS/editor
.vscode/
.DS_Store
Thumbs.db

# Portal (Next.js) — covered by portal/.gitignore but catch from root too
portal/node_modules/
portal/.next/

# Graduation book + pitch deck (self-contained HTML; build renders are disposable).
